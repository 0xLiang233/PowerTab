{
  "manifest_version": 3,
  "name": "Power Tab",
  "version": "0.1.7",
  "description": "A new-tab launcher and tab manager that reuses open tabs intelligently.",
  "permissions": [
    "tabs",
    "storage",
    "favicon",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "quick-tab-switcher": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Open Quick Tab Switcher"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "_favicon/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "Power Tab"
  }
}
